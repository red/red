# PROBE ONLY - not wired into any workflow yet.
#
# Same 32-bit Red/System environment as CI/Linux-32/Dockerfile, but on
# Debian 12 (bookworm) i386 instead of Ubuntu 18.04 (bionic).
# Differences that matter:
#   * bookworm is a supported release (security until 2026, LTS until 2028)
#   * i386 is a full architecture in Debian, not Ubuntu's whitelist subset
#   * mirrors are deb.debian.org (CDN-backed) instead of archive.ubuntu.com
FROM alpine:3.20 AS rebol-fetch

RUN set -eux; \
    for attempt in 1 2 3; do \
        if wget -q -O /rebol https://static.red-lang.org/tmp/rebol; then break; fi; \
        echo "rebol download failed (attempt $attempt), retrying..."; \
        sleep 3; \
    done; \
    test -s /rebol; \
    chmod +x /rebol

FROM i386/debian:12-slim

COPY --from=rebol-fetch /rebol /bin/rebol
COPY entrypoint.sh /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]
